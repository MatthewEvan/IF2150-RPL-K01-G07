# Salin berkas ini menjadi `.env.test` di folder `src/` untuk pengujian integrasi
# terhadap Supabase lokal (`npx supabase start`), lalu isi nilainya dari
# `npx supabase status -o env`. Jika `.env.test` tidak dibuat, `setupEnv.ts`
# akan mengambil nilai otomatis dari `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pengaman agar pengujian tulis tidak berjalan ke Supabase hosted secara tidak sengaja.
INTEGRASI_IZINKAN_HOSTED=false
